PORT=5000
NODE_ENV=development
DATABASE_URL=mysql://root:password@localhost:3306/atelier_auth
JWT_SECRET=replace_with_a_long_random_secret

# FRONTEND_URL - Use localhost for development, your domain for production
# For mobile compatibility, use a public URL (ngrok, your domain, or public IP)
# Development (local only): http://localhost:5173
# Development (local network): http://YOUR_LOCAL_IP:5173
# Production: https://yourdomain.com
FRONTEND_URL=http://localhost:5173

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your_smtp_username
EMAIL_PASSWORD=your_smtp_password
EMAIL_FROM="Atelier <no-reply@example.com>"

# ISRO Bhuvan API
BHUVAN_API_KEY=your_bhuvan_api_key_here
BHUVAN_BASE_URL=https://bhuvan-app1.nrsc.gov.in