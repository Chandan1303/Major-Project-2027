# Flask settings. The supported setup is to copy the repository-root
# .env.example to .env; run_backend.py loads that root file automatically.
PORT=5000
JWT_SECRET=replace_with_a_long_random_secret
FRONTEND_URL=http://localhost:5173

# Leave unset to use backend/sugar_yield.db (SQLite).
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/sugar_yield?charset=utf8mb4

# Optional email delivery
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your_smtp_username
EMAIL_PASSWORD=your_smtp_password
EMAIL_FROM=SugarYield AI <no-reply@example.com>

# Optional integrations
OPENWEATHER_API_KEY=your_openweather_api_key_here
BHUVAN_API_KEY=your_bhuvan_api_key_here
BHUVAN_BASE_URL=https://bhuvan-app1.nrsc.gov.in
