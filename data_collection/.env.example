# Data Collection API Keys
# Copy this file to .env and add your actual API keys

# OpenWeather API
# Get your key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# MOSDAC (Indian satellite data)
# Register at: https://www.mosdac.gov.in/
MOSDAC_USERNAME=your_mosdac_username
MOSDAC_PASSWORD=your_mosdac_password

# Google Earth Engine (for Sentinel-2 NDVI)
# Setup at: https://earthengine.google.com/
GEE_PROJECT_ID=your_gee_project_id

# ISRO Bhuvan API (if available)
# Register at: https://bhuvan-app1.nrsc.gov.in/api/
BHUVAN_API_KEY=your_bhuvan_api_key
